---
import '../styles/global.css';
import { SITE_NAME, SITE_INDEXABLE, GOOGLE_SITE_VERIFICATION } from '../consts';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	schema?: object[];
}

const { title, description, noindex = false, type = 'website', schema = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const robots = !SITE_INDEXABLE || noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_CA" />
<meta name="twitter:card" content="summary" />

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
