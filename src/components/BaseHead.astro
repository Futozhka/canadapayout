---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import jakarta400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import jakarta800 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url';
import { SITE_NAME, SITE_INDEXABLE, GOOGLE_SITE_VERIFICATION, GA_MEASUREMENT_ID } from '../consts';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	schema?: object[];
}

const { title, description, noindex = false, type = 'website', schema = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site).href;
const robots = !SITE_INDEXABLE || noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preload" href={jakarta800} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={jakarta400} as="font" type="font/woff2" crossorigin />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_CA" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME}: casino withdrawals in Canada, explained`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

{GA_MEASUREMENT_ID && (
	<script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
		// Google Analytics loads after the first interaction or 3.5 s after page load,
		// so its ~176 KiB script does not compete with the page's own content (LCP, TBT).
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () {
			window.dataLayer.push(arguments);
		};
		window.gtag('js', new Date());
		window.gtag('config', id);
		var gaLoaded = false;
		function loadGA() {
			if (gaLoaded) return;
			gaLoaded = true;
			var s = document.createElement('script');
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
			document.head.appendChild(s);
		}
		['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) {
			window.addEventListener(e, loadGA, { once: true, passive: true });
		});
		window.addEventListener('load', function () {
			setTimeout(loadGA, 3500);
		});
	</script>
)}
