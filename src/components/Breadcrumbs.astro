---
import type { Crumb } from '../lib';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
	<ol>
		{crumbs.map((c, i) => (
			<li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
		))}
	</ol>
</nav>
