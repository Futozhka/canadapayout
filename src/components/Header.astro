---
import { SITE_NAME, SITE_TAGLINE } from '../consts';

const links = [
	{ href: '/guides/', label: 'Guides' },
	{ href: '/tools/wagering-calculator/', label: 'Wagering calculator' },
	{ href: '/how-we-test/', label: 'How we test' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap header-row">
		<a href="/" class="brand" aria-label={`${SITE_NAME} home`}>
			<span class="brand-name">{SITE_NAME}</span>
			<span class="brand-tag">{SITE_TAGLINE}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{links.map((l) => (
					<li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>
