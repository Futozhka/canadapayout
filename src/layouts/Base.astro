---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	schema?: object[];
}
const props = Astro.props;
---

<!doctype html>
<html lang="en-CA">
	<head>
		<BaseHead {...props} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<slot />
		</main>
		<Footer />
	</body>
</html>
